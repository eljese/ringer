{
  "enableTelemetry": false,
  "allowNonWorkspaceAccess": false,
  "permissions": {
    "allow": [
      "read_file(*)",
      "grep_search(*)",
      "list_dir(*)",
      "list_directory(*)",
      "write_file(*)"
    ],
    "deny": [
      "command(*)",
      "run_command(*)",
      "Bash(*)",
      "bash(*)",
      "mcp(*)",
      "search_web(*)",
      "web_search(*)",
      "read_url_content(*)"
    ]
  }
}
